{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      ".env.example": "allow",
      ".env*": "deny"
    },
    "edit": {
      ".env*": "deny"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "lab2-corpus": {
      "type": "local",
      "command": ["npx", "tsx", "src/mcp/server.ts"],
      "enabled": true,
      "environment": { "MCP_CLIENT_LABEL": "opencode" },
      "timeout": 15000
    }
  }
}